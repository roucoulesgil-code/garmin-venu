<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Valeurs par defaut, modifiables depuis Garmin Connect / le simulateur -->
    <properties>
        <property id="showAlarm" type="boolean">true</property>
        <property id="accentColor" type="number">0x00AAFF</property>
    </properties>

    <settings>
        <setting propertyKey="@Properties.showAlarm" title="@Strings.SettingShowAlarm">
            <settingConfig type="boolean"/>
        </setting>

        <setting propertyKey="@Properties.accentColor" title="@Strings.SettingAccentColor">
            <settingConfig type="list">
                <listEntry value="0x00AAFF">Bleu</listEntry>
                <listEntry value="0xFF5500">Orange</listEntry>
                <listEntry value="0x00FF55">Vert</listEntry>
            </settingConfig>
        </setting>
    </settings>
</resources>